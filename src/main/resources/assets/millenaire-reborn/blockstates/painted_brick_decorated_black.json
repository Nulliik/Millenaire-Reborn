{
	"multipart": [
        {   "apply": { "model": "millenaire-reborn:painted_brick_black" }
        },
        {   "when": { "top_frieze":"true" },
            "apply": { "model": "millenaire-reborn:painted_brick_decoration1_top" }
        },
        {   "when": { "bottom_frieze":"true", "top_frieze":"false" },
            "apply": { "model": "millenaire-reborn:painted_brick_decoration1_bottom" }
        },
        {   "when": { "bottom_frieze":"false", "top_frieze":"false" },
            "apply": { "model": "millenaire-reborn:painted_brick_decoration1" }
        }

    ]
}
